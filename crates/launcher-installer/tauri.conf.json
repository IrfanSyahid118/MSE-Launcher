{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSE Launcher Setup",
  "version": "1.2.0",
  "identifier": "com.mclauncher.installer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MSE Launcher Setup",
        "width": 720,
        "height": 530,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
